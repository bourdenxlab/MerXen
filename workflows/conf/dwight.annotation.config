/*
 * Annotation host settings for the-dwight workstation (plan §3.7; hook H7).
 *
 * Included from dwight.config, so the standard, dwight and local profiles all
 * read it. It overrides annotation.config defaults with local source paths and
 * reference stores, and sets host concurrency for the annotation processes.
 * Nothing here is read while both species use clustering_squidpy_mode legacy.
 *
 * The maxForks params take effect through withName blocks that arrive with
 * their processes (PREP in M2, MAP in M3, RESOLVE in M4, COMPUTE_CPU in M5,
 * REPORT in M7): a selector without a process would only print a warning in
 * every legacy run.
 * CLUSTERING_SQUIDPY_COMPUTE_CPU uses clustering_squidpy_max_forks (4, in
 * dwight.config). The annotation processes are CPU-only and take no GPU lock.
 */

params {
    // Reference stores (OD-D10, OD-E6), both on /srv/storage: panels <= 1,000
    // genes in annotation_references, larger ones (e.g. Xenium 5K, with their
    // reference markers kept) in their own store directory. The main store was
    // on SSD1 until the user's decision U6 (a) of 2026-10-14: SSD1 is failing
    // (annotation_dev/SSD1_DAMAGE_20261013.md), so no store default may point
    // there. The /srv store holds mouse bundles only (VZG2 wmb_panel,
    // wmb_region_share, wmb_selfmap_testset); a human run finds no human
    // bundle in it and would rebuild from the human sources below, which are
    // still on SSD1 (the launch guard refuses them) until U6 (b).
    annotation_reference_store = "/srv/storage/MerXen/annotation_references"
    annotation_reference_store_large = "/srv/storage/MerXen/annotation_references_large"

    // Local reference sources (copied with a checksum into a bundle, never
    // symlinked). SEA-AD and the MERFISH CCF metadata are fetched once into
    // <annotation_reference_store>/.downloads from their pinned URLs and
    // verified by size and sha256 (annotation_auto_download).
    annotation_whb_region_precompute_source = "/media/mathieubo/SSD1/MerXen/mapmycells/references/region_frontal_a44_a45_a46_a32_acc"
    annotation_whb_h5ad_dir = "/media/mathieubo/SSD1/MerXen/mapmycells/abc_whb/expression_matrices/WHB-10Xv3/20240330"
    annotation_whb_metadata_dir = "/media/mathieubo/SSD1/MerXen/mapmycells/abc_whb/metadata"
    // The mouse sources are the verified ABC Atlas download on /srv/storage
    // (references/abc_atlas/MANIFEST.tsv, sha256 and size per file). SSD1 is
    // failing (annotation_dev/SSD1_DAMAGE_20261013.md): no mouse default may
    // point there. These strings are byte-identical to the VZG2 map_first run
    // that built the wmb_panel bundle af3fab09: build_hash covers the
    // resolved source paths, so only these paths keep that bundle reusable.
    annotation_wmb_h5ad_dir = "/srv/storage/MerXen/references/abc_atlas/expression_matrices/WMB-10Xv3/20230630"
    annotation_wmb_metadata_dir = "/srv/storage/MerXen/references/abc_atlas/metadata"
    annotation_wmb_mapping_stats_path = "/srv/storage/Araceli-ageing/abc_atlas/mapmycells/WMB-10X/20240831/precomputed_stats_ABC_revision_230821.h5"
    annotation_merfish_ccf_metadata_path = "/srv/storage/MerXen/references/abc_atlas/metadata/MERFISH-C57BL6J-638850-CCF/20231215/views/cell_metadata_with_parcellation_annotation.csv"
    // Gene tables of the exact-case species test and the symbol fallback
    // (plan §8.4): the WHB-10Xv3 var (59,357 genes; the M0e fallback table of
    // dwight.config) and the WMB-10X gene.csv (32,285 genes). The human table
    // is still on SSD1 (only its var index is read; the file is the one
    // exception the launch guard allows until the human sources move); the
    // mouse table is the md5-checked copy on /srv/storage.
    annotation_human_gene_table = "/media/mathieubo/SSD1/MerXen/mapmycells/abc_whb/expression_matrices/WHB-10Xv3/20240330/WHB-10Xv3-Nonneurons-raw.h5ad"
    annotation_mouse_gene_table = "/srv/storage/MerXen/references/abc_atlas/metadata/WMB-10X/20241115/gene.csv"
    // The 11,913 WMB self-map test cells (<= 10 per supertype), excluded from
    // the wmb_panel marker build so the resolvability test set stays disjoint.
    // A byte-identical copy of research/selfmap/truth.csv (sha256 1b921d93...).
    annotation_wmb_selfmap_test_cells_path = "/srv/storage/MerXen/references/wmb_selfmap/truth_20260925.csv"

    // Host concurrency: PREP 1, MAP 2, RESOLVE 4, REPORT 2 (COMPUTE_CPU:
    // clustering_squidpy_max_forks, 4, in dwight.config).
    annotation_prep_max_forks = 1
    annotation_max_forks = 2
    annotation_resolve_max_forks = 4
    annotation_report_max_forks = 2
}

process {
    // One reference build at a time on this host: a WMB build holds 8 CPUs
    // and up to ~20 GB for about 40 min, and concurrent launches serialise on
    // the store's per-reference lock anyway.
    withName: "ANNOTATE_REFERENCE_PREP" {
        maxForks = params.annotation_prep_max_forks
    }
    // Two MAP tasks at a time on this shared host (plan §3.3, §10): 12 CPUs
    // and 2 x 24 GB reserved; measured in the M3 shadow runs, a human pair x
    // segmentation maps in 3-5 min (80-315 s) and a mouse section in about
    // 5 min per segmentation, with a mapper peak RSS below 3.5 GB.
    withName: "CLUSTERING_SQUIDPY_ANNOTATE_MAP" {
        maxForks = params.annotation_max_forks
    }
    // Four RESOLVE tasks at a time (8 CPUs, 4 x 16 GB reserved): a run of 8
    // pairs x 2 segmentations resolves in about four one-minute rounds instead
    // of reserving 32 CPUs and 256 GB of the shared host at once.
    withName: "CLUSTERING_SQUIDPY_ANNOTATE_RESOLVE" {
        maxForks = params.annotation_resolve_max_forks
    }
    // At most clustering_squidpy_max_forks (4, dwight.config) map_first
    // hierarchies at a time, as for the legacy COMPUTE (plan §3.5): 32 CPUs
    // and 4 x 32 GB reserved on this shared host. CPU only: no GPU lock.
    withName: "CLUSTERING_SQUIDPY_COMPUTE_CPU" {
        maxForks = params.clustering_squidpy_max_forks
    }
    // Two annotation reports at a time (plan §3.6): 8 CPUs and 2 x 32 GB
    // reserved; a human pair's report takes about a minute.
    withName: "ANNOTATION_REPORT" {
        maxForks = params.annotation_report_max_forks
    }
}
