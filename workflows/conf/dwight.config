/*
 * Execution settings for the-dwight workstation.
 *
 * Scientific and algorithmic defaults remain in ../nextflow.config. This file
 * contains hardware choices, concurrency limits, and local executor capacity
 * that a future HPC profile will replace. The host's data locations (reference
 * sources and stores, the Cellpose model store and protected output roots, the
 * task temporary directory) are in the private dwight.site.config, included
 * below.
 */

params {
    // Local software and GPU availability
    cellpose_gpu = true
    // Device of the bead-removal correction: the GPU backend, validated on this
    // host with torch 2.14 / Triton 3.8 (the pipeline environment).
    merscope_bead_removal_device = "cuda"
    proseg_binary = "/usr/local/bin/proseg"
    proseg_search_paths = [
        "/usr/bin/proseg",
        "/usr/local/bin/proseg",
    ]
    proseg_install_path = "/usr/local/bin/proseg"
    proseg_num_threads = 32
    alignment_device = "auto"
    alignment_pytorch_cuda_alloc_conf = "expandable_segments:True,max_split_size_mb:256"
    clustering_squidpy_use_gpu = true
    clustering_squidpy_gpu_vram_monitor = true
    clustering_squidpy_gpu_vram_monitor_interval_seconds = 2
    gaston_use_gpu = true
    gaston_gpu_vram_monitor = true
    gaston_gpu_vram_monitor_interval_seconds = 2

    // Host-level concurrency
    mask_image_quantification_max_forks = 3
    register_images_max_forks = 2
    // Nine 60 GB / 8 CPU reservations use at most 540 GB and 72 CPUs,
    // leaving a conservative margin on the 775 GB / 80-thread workstation.
    viewer_cache_max_forks = 9
    cortical_depth_max_forks = 3
    distance_from_object_n_cpus = 8
    distance_from_object_max_forks = 3
    alignment_max_forks = 1
    mecr_max_forks = 4
    clustering_squidpy_max_forks = 4
    spatial_gene_analysis_max_forks = 4
    mender_prepare_max_forks = 4
    mender_compute_max_forks = 2
    mender_finalize_max_forks = 4
    mender_import_max_forks = 1
    gaston_prepare_max_forks = 2
    gaston_glmpca_max_forks = 2
    gaston_train_max_forks = 1
    gaston_postprocess_max_forks = 2
    gaston_import_max_forks = 1

    // Workstation memory and scheduling limits
    max_ram_gb = 640
    warn_ram_gb = 600
    transcript_chunk_rows = 1000000
    build_spatialdata_max_forks = 3
    cellpose_segment_max_forks = 1
    proseg_segment_max_forks = 2
    gpu_process_lock_enabled = true
    // All tasks and concurrent launches on Dwight share one GPU lock.
    gpu_process_lock_file = "/tmp/merxen-dwight-gpu.lock"
    mapmycells_n_processors = 8
}

// rca-hook:H7: annotation concurrency on this host (the source paths and stores are in the site config below).
includeConfig 'dwight.annotation.config'

// Private host locations (gitignored; template dwight.site.config.example): the reference
// sources and stores, the Cellpose model store and protected output roots, task_tmp_dir and
// the task env (TMPDIR, MERXEN_ALIAS_FILE). Found at $MERXEN_DWIGHT_SITE_CONFIG, else
// conf/dwight.site.config; 'none' or /dev/null (or no file) = none, and main.nf then stops
// the launch unless the variable is 'none' or /dev/null (docs/local-configuration.md).
includeConfig (System.getenv('MERXEN_DWIGHT_SITE_CONFIG') in ['none', '/dev/null'] ? '/dev/null' : (System.getenv('MERXEN_DWIGHT_SITE_CONFIG') ?: (new File("${projectDir}/conf/dwight.site.config").exists() ? "${projectDir}/conf/dwight.site.config" : '/dev/null')))

process.executor = "local"

// Advertise host capacity to the local executor without turning it into the
// default resource request for every process.
executor {
    cpus = 72
    memory = "640 GB"
}

process {
    withName: "BUILD_SPATIALDATA" {
        maxForks = params.build_spatialdata_max_forks
        // Only the path is exported. The bead-removal GPU phase takes the lock
        // itself around the window loop, so the GPU is not held for the whole
        // build (calibration, projection of the other stains and the write).
        beforeScript = """
            if [[ "${params.gpu_process_lock_enabled}" == "true" ]]; then
                export MERXEN_GPU_LOCK_FILE="${params.gpu_process_lock_file}"
            fi
        """.stripIndent().trim()
    }
    withName: "CELLPOSE_SEGMENT" {
        maxForks = params.cellpose_segment_max_forks
        beforeScript = """
            if [[ "${params.gpu_process_lock_enabled}" == "true" && "${params.cellpose_gpu}" == "true" ]]; then
                MERXEN_GPU_LOCK_FILE="${params.gpu_process_lock_file}"
                mkdir -p "\$(dirname "\${MERXEN_GPU_LOCK_FILE}")"
                if [[ ! -e "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    (umask 022; set -o noclobber; : > "\${MERXEN_GPU_LOCK_FILE}") 2>/dev/null || true
                fi
                if [[ ! -r "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    echo "MerXen GPU lock is not readable: \${MERXEN_GPU_LOCK_FILE}" >&2
                    exit 1
                fi
                exec 9<"\${MERXEN_GPU_LOCK_FILE}"
                echo "Waiting for MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
                flock 9
                echo "Acquired MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
            fi
        """.stripIndent().trim()
    }
    withName: "CELLPOSE_NUCLEI_SEGMENT" {
        maxForks = params.cellpose_segment_max_forks
        beforeScript = """
            if [[ "${params.gpu_process_lock_enabled}" == "true" && "${params.cellpose_gpu}" == "true" ]]; then
                MERXEN_GPU_LOCK_FILE="${params.gpu_process_lock_file}"
                mkdir -p "\$(dirname "\${MERXEN_GPU_LOCK_FILE}")"
                if [[ ! -e "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    (umask 022; set -o noclobber; : > "\${MERXEN_GPU_LOCK_FILE}") 2>/dev/null || true
                fi
                if [[ ! -r "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    echo "MerXen GPU lock is not readable: \${MERXEN_GPU_LOCK_FILE}" >&2
                    exit 1
                fi
                exec 9<"\${MERXEN_GPU_LOCK_FILE}"
                echo "Waiting for MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
                flock 9
                echo "Acquired MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
            fi
        """.stripIndent().trim()
    }
    withName: "PROSEG_SEGMENT" {
        maxForks = params.proseg_segment_max_forks
    }
    withName: "VIEWER_CACHE" {
        memory = "60 GB"
        maxForks = params.viewer_cache_max_forks
    }
    withName: "REGISTER_IMAGES" {
        maxForks = params.register_images_max_forks
    }
    withName: "MASK_IMAGE_QUANTIFICATION" {
        maxForks = params.mask_image_quantification_max_forks
    }
    withName: "COMPUTE_CORTICAL_DEPTH" {
        maxForks = params.cortical_depth_max_forks
    }
    withName: "DISTANCE_FROM_OBJECT_ANNOTATE" {
        maxForks = params.distance_from_object_max_forks
    }
    withName: "ALIGN" {
        maxForks = params.alignment_max_forks
        beforeScript = """
            if [[ "${params.gpu_process_lock_enabled}" == "true" && "${params.alignment_device}" != "cpu" ]]; then
                MERXEN_GPU_LOCK_FILE="${params.gpu_process_lock_file}"
                mkdir -p "\$(dirname "\${MERXEN_GPU_LOCK_FILE}")"
                if [[ ! -e "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    (umask 022; set -o noclobber; : > "\${MERXEN_GPU_LOCK_FILE}") 2>/dev/null || true
                fi
                if [[ ! -r "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    echo "MerXen GPU lock is not readable: \${MERXEN_GPU_LOCK_FILE}" >&2
                    exit 1
                fi
                exec 9<"\${MERXEN_GPU_LOCK_FILE}"
                echo "Waiting for MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
                flock 9
                echo "Acquired MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
            fi
        """.stripIndent().trim()
    }
    withName: "MATERIALIZE_ALIGNMENT" {
        maxForks = params.alignment_materialization_max_forks
    }
    withName: "CLUSTERING_SQUIDPY_COMPUTE" {
        maxForks = params.clustering_squidpy_max_forks
        beforeScript = """
            if [[ "${params.gpu_process_lock_enabled}" == "true" && "${params.clustering_squidpy_use_gpu}" == "true" ]]; then
                MERXEN_GPU_LOCK_FILE="${params.gpu_process_lock_file}"
                mkdir -p "\$(dirname "\${MERXEN_GPU_LOCK_FILE}")"
                if [[ ! -e "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    (umask 022; set -o noclobber; : > "\${MERXEN_GPU_LOCK_FILE}") 2>/dev/null || true
                fi
                if [[ ! -r "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    echo "MerXen GPU lock is not readable: \${MERXEN_GPU_LOCK_FILE}" >&2
                    exit 1
                fi
                exec 9<"\${MERXEN_GPU_LOCK_FILE}"
                echo "Waiting for MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
                flock 9
                echo "Acquired MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
            fi
        """.stripIndent().trim()
    }
    withName: "GASTON_PREPARE" {
        maxForks = params.gaston_prepare_max_forks
    }
    withName: "GASTON_GLM_PCA" {
        maxForks = params.gaston_glmpca_max_forks
    }
    withName: "GASTON_TRAIN" {
        maxForks = params.gaston_train_max_forks
        beforeScript = {
            if (!(params.gpu_process_lock_enabled && use_gpu)) {
                return ""
            }
            return """
            if [[ "${params.gpu_process_lock_enabled}" == "true" && "${params.gaston_use_gpu}" == "true" ]]; then
                MERXEN_GPU_LOCK_FILE="${params.gpu_process_lock_file}"
                mkdir -p "\$(dirname "\${MERXEN_GPU_LOCK_FILE}")"
                if [[ ! -e "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    (umask 022; set -o noclobber; : > "\${MERXEN_GPU_LOCK_FILE}") 2>/dev/null || true
                fi
                if [[ ! -r "\${MERXEN_GPU_LOCK_FILE}" ]]; then
                    echo "MerXen GPU lock is not readable: \${MERXEN_GPU_LOCK_FILE}" >&2
                    exit 1
                fi
                exec 9<"\${MERXEN_GPU_LOCK_FILE}"
                echo "Waiting for MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
                flock 9
                echo "Acquired MerXen GPU process lock: \${MERXEN_GPU_LOCK_FILE}" >&2
            fi
        """.stripIndent().trim()
        }
    }
    withName: "GASTON_POSTPROCESS" {
        maxForks = params.gaston_postprocess_max_forks
    }
    withName: "GASTON_IMPORT" {
        maxForks = params.gaston_import_max_forks
    }
    withName: "SPATIAL_GENE_ANALYSIS" {
        maxForks = params.spatial_gene_analysis_max_forks
    }
    withName: "MENDER_PREPARE" {
        maxForks = params.mender_prepare_max_forks
    }
    withName: "MENDER_COMPUTE" {
        maxForks = params.mender_compute_max_forks
    }
    withName: "MENDER_FINALIZE" {
        maxForks = params.mender_finalize_max_forks
    }
    withName: "MENDER_IMPORT" {
        maxForks = params.mender_import_max_forks
    }
    withName: "MECR" {
        maxForks = params.mecr_max_forks
    }
}
