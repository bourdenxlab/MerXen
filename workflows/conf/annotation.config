/*
 * Reference-based cell-type annotation params (plan §3.7; hook H7).
 *
 * Only annotation params live here; params introduced by the M0 fixes stay in
 * ../nextflow.config and dwight.config (mapmycells_n_processors,
 * qc_registration_strict, annotation_gene_id_fallback_csv).
 * tests/test_workflows/test_annotation_config_no_duplicates.py fails if a
 * param is defined both here and there, so this include can never override a
 * base or profile value. Host paths and concurrency are in
 * dwight.annotation.config.
 *
 * Human runs map_first by default since the M8 flip (pre-registration §20);
 * mouse stays legacy until its flip (M9), and legacy rows read none of the
 * other params. A samplesheet row's clustering_squidpy_mode column (legacy /
 * map_first) overrides the run's mode for that row (§20 D15).
 * workflows/lib/AnnotationDefaults.groovy holds the species rules (mode,
 * table-key suffix, defaults).
 *
 * The process block sets the resources of the annotation processes (plan
 * §3.1, §3.3, §3.4, §8.7); they run only in --annotation_prepare_only and
 * map_first runs. The 1,000-gene large-panel limit below is
 * merxen.annotation.config.LARGE_PANEL_GENES (test_annotation_module.py).
 */

params {
    clustering_squidpy_mode_human = "map_first"    // flipped at M8 (pre-registration §20)
    clustering_squidpy_mode_mouse = "legacy"       // M9 -> "map_first"
    clustering_squidpy_mode = null                 // explicit override for both species
    // null => "mapfirst" if the resolved mode is map_first and that species'
    // default is still legacy; "" otherwise (always "" in legacy runs).
    clustering_squidpy_table_key_suffix = null
    annotation_reference_store = null              // null => ${outdir}/annotation_references
    annotation_reference_store_large = null        // > 1,000-gene panels
    annotation_human_references = "whb_frontal_supc_clus,seaad_mr_panel"
    annotation_mouse_references = "wmb_panel,wmb_region_share"
    annotation_human_region = "frontal_cortex"     // also samplesheet column anatomical_region
    annotation_mouse_section_regions = "auto"      // also samplesheet column mouse_section_regions
    annotation_whb_region_precompute_source = null
    annotation_whb_h5ad_dir = null
    annotation_whb_metadata_dir = null
    annotation_gene_alias_table = null             // optional local HGNC / MGI previous-symbol table (no network)
    // Local gene tables of both species (WHB var / WMB gene.csv; no network):
    // the run species' table is the symbol fallback (else
    // annotation_gene_id_fallback_csv), both feed the exact-case species test.
    annotation_human_gene_table = null
    annotation_mouse_gene_table = null
    annotation_gene_id_overrides_csv = null        // curated symbol -> Ensembl overrides, per species
    annotation_panel_mode = "auto"                 // auto | intersection | per_platform
    annotation_resolvability = true
    // PREP memory for > 1,000-gene panels (OD-E8): the M3b 5K measurement
    // (Xenium Prime 5K Mouse on WMB, 8 processes, --max-gb 40) peaked at
    // 37.7 GB with the prefilter (query markers) and at 27.2 GB without it,
    // the default (reference-marker process tree); + 30% = 49 GB, so the
    // standard 64 GB reserve the measurement ran under (--max-gb 40 =
    // 64 x 0.625) covers it.
    annotation_prep_large_memory = "64 GB"
    annotation_allow_fine_levels = false           // OD-E4: report-only opt-in columns
    annotation_seaad_precomputed_stats_path = null // downloaded (pinned URL + sha256) if null and auto_download
    annotation_seaad_metadata_dir = null
    annotation_wmb_h5ad_dir = null
    annotation_wmb_metadata_dir = null
    annotation_wmb_mapping_stats_path = null
    annotation_wmb_selfmap_test_cells_path = null  // self-map test cells (research/selfmap/truth.csv) kept out of the wmb_panel marker build; required while annotation_resolvability is true
    annotation_wmb_marker_gene_universe_path = null // override of the wmb_panel marker universe (null: the validated ag7 | VZG2 union for panels inside it)
    annotation_wmb_max_cells_per_cluster = 50
    annotation_merfish_ccf_metadata_path = null
    annotation_auto_download = true
    annotation_panel_genes_path = null             // prepare-only without zarr inputs
    annotation_prepare_only = false
    annotation_max_forks = 2
    annotation_ctm_version = "1.7.2"
    annotation_keep_extended_json = false
    annotation_reuse_published = true
    annotation_xplat_sensitivity = "geneset_c"     // off | geneset_c | geneset_c+rescale
    annotation_xplat_sensitivity_segmentations = "proseg_hybrid"
    annotation_human_microglia_flag = false
    annotation_allow_single_method = false         // degraded mode: WHB only below 60 counts (§5.3)
    annotation_mouse_lkloc = false                 // optional mouse glial second opinion, report only
    annotation_calibration_holdout_donor = "auto"  // held-out donor (auto = H19.30.002)
    annotation_report_enabled = true
    annotation_mode_mapmycells_stage = null        // null => "skip" for a flipped species, else "legacy"
    mender_unassigned_state_policy = "exclude_from_features" // map_first only; legacy keeps "state"
}

process {
    // ANNOTATE_PANEL reads one pair's declared panels: seconds, one CPU.
    withName: "ANNOTATE_PANEL" {
        cpus = 1
        memory = "4 GB"
    }
    // One bundle per (species, reference, panel): 8 cpus / 64 GB / 8 h for
    // panels of up to 1,000 genes (WMB query markers peak at 20-27 GB); above
    // that, annotation_prep_large_memory (the M3b 5K measurement + 30%,
    // OD-E8) and 24 h (the 5K mouse bundle took 1.6 h).
    withName: "ANNOTATE_REFERENCE_PREP" {
        cpus = 8
        memory = {
            (bundle.n_panel_genes ?: 0) > 1000 && params.annotation_prep_large_memory
                ? params.annotation_prep_large_memory
                : "64 GB"
        }
        time = { (bundle.n_panel_genes ?: 0) > 1000 ? "24h" : "8h" }
    }
    // MAP maps one pair x segmentation onto its bundles: 6 MapMyCells worker
    // processes (--n-processors task.cpus, one BLAS thread each) and 24 GB;
    // panels above 1,000 genes 48 GB (plan §3.3). Measured peaks (M3 stage
    // A, 6 processes): 2.8 GB RSS for human proseg_hybrid pairs, 3.3 GB for
    // ag7 (WMB); E5: 2.2-3.95 GB (SEA-AD), 6.2 GB (WMB).
    withName: "CLUSTERING_SQUIDPY_ANNOTATE_MAP" {
        cpus = 6
        memory = { (map_spec.n_panel_genes ?: 0) > 1000 ? "48 GB" : "24 GB" }
    }
    // RESOLVE turns one pair x segmentation's mapping into label tables: one
    // Python process (BLAS one thread) and 16 GB, minutes (plan §3.4).
    // Measured (M4 stage B, 8 human pairs x proseg_hybrid and reseg, 300-gene
    // panels, 200 bootstrap replicates): 36-63 s, peak RSS 3.4-4.7 GB. Above
    // 1,000 panel genes 32 GB: the counts RESOLVE reloads grow with the panel
    // (not yet measured on a 5K panel).
    withName: "CLUSTERING_SQUIDPY_ANNOTATE_RESOLVE" {
        cpus = 2
        memory = { (resolve_spec.n_panel_genes ?: 0) > 1000 ? "32 GB" : "16 GB" }
    }
    // COMPUTE_CPU builds the map_first hierarchy and QC embedding of one pair
    // x segmentation in the main environment: 8 CPUs, 32 GB, CPU only, no
    // GPU lock (plan §3.5). Measured (M5 stage A, human proseg_hybrid sections of
    // 103-164k table cells, 8 threads, shared host): 15-28 min and 2.3-3.5 GB
    // peak RSS per section, i.e. about 30-55 min per pair.
    withName: "CLUSTERING_SQUIDPY_COMPUTE_CPU" {
        cpus = 8
        memory = "32 GB"
    }
    // The annotation QC report of one pair x segmentation (plan §3.6): 4
    // CPUs (BLAS threads) and 32 GB. Measured (M7, the published P7513 /
    // P1212 proseg_hybrid outputs, 300-gene panels, 200 block-bootstrap
    // replicates, one Python process): 30-40 s and 3.6-4.2 GB peak RSS per
    // pair; the counts it reads for items 4 and 7 grow with the panel.
    withName: "ANNOTATION_REPORT" {
        cpus = 4
        memory = "32 GB"
    }
}
