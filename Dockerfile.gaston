FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --index-url https://download.pytorch.org/whl/cu118 \
    "torch==2.0.1"

RUN python3 -m pip install \
    "setuptools==80.9.0" \
    "numpy==1.23.5" \
    "gaston-spatial @ git+https://github.com/raphael-group/GASTON.git@79577c45111b3442b808c8e620711b822965493b" \
    "glmpca==0.1.0" \
    "kneed==0.8.5" \
    "scanpy==1.9.5" \
    "squidpy==1.3.1" \
    "dask[array,dataframe]>=2024.4.1,<2025" \
    "anndata==0.9.2" \
    "matplotlib==3.8.0" \
    "pandas==2.1.1" \
    "pyarrow>=15,<24" \
    "scikit-learn==1.3.1" \
    "scipy==1.11.2" \
    "seaborn==0.12.2" \
    "statsmodels==0.14.0" \
    "psutil>=5.9" \
    "pydantic>=2.0" \
    "pydantic-settings>=2.0" \
    "tqdm==4.66.1"

# Fail the image build if the pinned Torch/GASTON runtime or the documented
# Scanpy/Squidpy dependencies cannot be imported.
RUN python3 -c "import torch; import scanpy, squidpy; from gaston import dp_related, model_selection, neural_net; print(torch.__version__)"

WORKDIR /opt/merxen
COPY src ./src
ENV PYTHONPATH=/opt/merxen/src

CMD ["python3"]
