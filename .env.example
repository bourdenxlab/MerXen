# Root directory for pipeline outputs
MERXEN_OUTPUT_ROOT=/path/to/output

# Optional Python-side ProSeg default. The Nextflow workflow primarily uses
# workflows/nextflow.config for ProSeg search/install settings.
MERXEN_PROSEG_INSTALL_PATH=/usr/bin/proseg

# Maximum system RAM in GB (for memory-aware tiling)
MERXEN_MAX_RAM_GB=600

# Optional slow test (pytest -m slow): check the committed annotation vocab
# tables against the real Allen taxonomy CSVs (scripts/annotation/build_vocab_tables.py).
# MERXEN_WHB_TAXONOMY_DIR=/path/to/abc/metadata/WHB-taxonomy/20240330
# MERXEN_SEAAD_TERM_CSV=/path/to/abc/metadata/SEA-AD-Multiregion-taxonomy/20260711/cluster_annotation_term.csv
# MERXEN_WMB_TAXONOMY_DIR=/path/to/abc/metadata/WMB-taxonomy/20231215

# Gene-ID fallback tables of the annotation shadow scripts
# (scripts/acceptance/*.py; the same files the MAP runs were given with
# --gene-id-fallback-csv). Without them the scripts require the options.
# MERXEN_GENE_ID_FALLBACK_CSV=/path/to/WHB-10Xv3-Nonneurons-raw.h5ad
# MERXEN_MOUSE_GENE_ID_FALLBACK_CSV=/path/to/WMB-10X/gene.csv
