# MerXen local configuration template. Copy to .env (gitignored) and fill in the
# values your work needs: docs/local-configuration.md.
#
# Format (shared by Python's merxen.local_config, bash `. .env` and the privacy
# hooks): KEY=VALUE, one per line; '#' starts a comment line; a value with
# spaces is double-quoted; no '$', backticks, backslashes, single quotes, '~'
# or 'export', so bash and Python read the same values.
#
# Every location below is commented out: a variable that is not set makes the
# code that needs it stop with an error naming it (never a built-in default),
# and tests that read real data skip. Uncomment and fill in only what you use.

# ===== Locations (merxen.local_config.KNOWN; keep in step with it) ==========

# --- Pointers to the other private files (needed by worktrees and code
# --- exports; unset = the checkout's own files). 'none' = absent on purpose.
# MERXEN_ALIAS_FILE=/path/to/private_config/aliases.tsv
# MERXEN_SITE_CONFIG=/path/to/MerXen/workflows/conf/site.config
# MERXEN_DWIGHT_SITE_CONFIG=/path/to/MerXen/workflows/conf/dwight.site.config

# --- Project storage ---------------------------------------------------------
# MERXEN_STORAGE_ROOT=/path/to/storage/MerXen
# MERXEN_ANNOTATION_DEV_DIR=/path/to/storage/MerXen/annotation_dev
# MERXEN_EVIDENCE_ROOT=/path/to/storage/MerXen/annotation_dev/evidence
# MERXEN_HEAVY_LOCK=/path/to/storage/MerXen/annotation_dev/heavy_compute.lock
# MERXEN_RESULTS_ROOT=/path/to/storage/MerXen/results
# MERXEN_REFERENCE_STORE=/path/to/storage/MerXen/annotation_references
# MERXEN_REFERENCE_STORE_LARGE=/path/to/storage/MerXen/annotation_references_large
# MERXEN_PUBLIC_VALIDATION_ROOT=/path/to/storage/MerXen/public_validation
# MERXEN_REFERENCES_DIR=/path/to/storage/MerXen/references
# MERXEN_ABC_ATLAS_DIR=/path/to/storage/MerXen/references/abc_atlas
# MERXEN_MOUSE_GENE_TABLE=/path/to/abc_atlas/metadata/WMB-10X/20241115/gene.csv
# MERXEN_WMB_SELFMAP_TEST_CELLS=/path/to/storage/MerXen/references/wmb_selfmap/truth.csv
# MERXEN_LEGACY_SNAPSHOT_DIR=/path/to/storage/MerXen/legacy_snapshot
# MERXEN_TASK_TMP_DIR=/path/to/storage/MerXen/tmp
# MERXEN_MERSCOPE_RAW_ROOT=/path/to/storage/MerXen/merscope

# --- Data owned by others (read-only) ----------------------------------------
# MERXEN_MS1_OWNER_ROOT=/path/to/ms1-owner
# MERXEN_MS1_CLUSTERED_H5AD=/path/to/ms1-owner/results/<MS1 pair id>/clustered.h5ad
# MERXEN_WMB_MAPPING_STATS=/path/to/mapmycells/WMB-10X/precomputed_stats.h5
# MERXEN_MS2_RAW_ROOT=/path/to/ms2-raw
# MERXEN_MS2_PUBLISHED_RESULTS=/path/to/ms2-raw/merxen_results
# MERXEN_HM_RAW_ROOT=/path/to/new-panel-raw

# --- Legacy disks (MERXEN_SSD1_ROOT and MERXEN_REFUSED_PATH_PREFIX hold the
# --- same value; the launch guard refuses anything under the prefix) ---------
# MERXEN_SSD1_ROOT=/path/to/legacy-disk
# MERXEN_SSD2_ROOT=/path/to/legacy-disk-2
# MERXEN_SS3_ROOT=/path/to/legacy-disk-3
# MERXEN_REFUSED_PATH_PREFIX=/path/to/legacy-disk
# MERXEN_HUMAN_GENE_TABLE=/path/to/legacy-disk/WHB-10Xv3-Nonneurons-raw.h5ad
# MERXEN_LEGACY_REFERENCE_STORE=/path/to/legacy-disk/MerXen/annotation_references
# MERXEN_MAPMYCELLS_CACHE_DIR=/path/to/legacy-disk/MerXen/mapmycells
# MERXEN_WHB_EXPRESSION_DIR=/path/to/abc_whb/expression_matrices/WHB-10Xv3/20240330
# MERXEN_WHB_METADATA_DIR=/path/to/abc_whb/metadata
# MERXEN_WHB_REGION_PRECOMPUTE_SOURCE=/path/to/mapmycells/references/region_source
# MERXEN_LEGACY_ABC_ATLAS_DIR=/path/to/legacy-disk/MerXen/mapmycells/abc_atlas
# MERXEN_LEGACY_WMB_GENE_CSV=/path/to/legacy-disk/abc_atlas/metadata/WMB-10X/20241115/gene.csv

# --- Notebooks (exploratory) -------------------------------------------------
# MERXEN_NOTEBOOK_RESULTS_ROOT=/path/to/results
# MERXEN_NOTEBOOK_MAPMYCELLS_CACHE_DIR=/path/to/mapmycells
# MERXEN_PANEL_CSV="/path/to/Panel/panel.csv"

# --- Optional inputs of scripts and slow tests --------------------------------
# Gene-ID fallback tables of the annotation shadow scripts (scripts/acceptance;
# the same files the MAP runs were given with --gene-id-fallback-csv). Without
# them the scripts require the options.
# MERXEN_GENE_ID_FALLBACK_CSV=/path/to/WHB-10Xv3-Nonneurons-raw.h5ad
# MERXEN_MOUSE_GENE_ID_FALLBACK_CSV=/path/to/WMB-10X/gene.csv
# Slow test (pytest -m slow): check the committed annotation vocab tables
# against the real Allen taxonomy CSVs (scripts/annotation/build_vocab_tables.py).
# MERXEN_WHB_TAXONOMY_DIR=/path/to/abc/metadata/WHB-taxonomy/20240330
# MERXEN_WMB_TAXONOMY_DIR=/path/to/abc/metadata/WMB-taxonomy/20231215
# MERXEN_SEAAD_TERM_CSV=/path/to/abc/metadata/SEA-AD-Multiregion-taxonomy/20260711/cluster_annotation_term.csv

# ===== Other settings (not locations) ========================================

# Root directory for pipeline outputs
MERXEN_OUTPUT_ROOT=/path/to/output

# Optional registry directory; export before launching Nextflow, or use
# --cellpose_model_store. Dwight's profile supplies its site default.
MERXEN_CELLPOSE_MODEL_STORE=/path/to/cellpose_models

# Optional Python-side ProSeg default. The Nextflow workflow primarily uses
# workflows/nextflow.config for ProSeg search/install settings.
MERXEN_PROSEG_INSTALL_PATH=/usr/bin/proseg

# Maximum system RAM in GB (for memory-aware tiling)
MERXEN_MAX_RAM_GB=600
